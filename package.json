    "admin:reset-password": "node scripts/with-db.mjs node scripts/admin-reset-password.mjs",
    "seed:sample": "node scripts/with-db.mjs node scripts/seed-sample.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "drizzle-orm": "0.45.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.4.4",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.12"
  }
