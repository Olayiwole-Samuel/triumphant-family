{
  "name": "tfam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-db.mjs next dev",
    "build": "node scripts/with-db.mjs next build",
    "start": "node scripts/with-db.mjs next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "db:migrate": "node scripts/with-db.mjs",
