# -----------------------------------------------------------------------------
# The Triumphant Family — environment variables
#
# Copy this file to `.env.local` for local development and fill in the values.
# On Vercel, add the same variables under Project → Settings → Environment
# Variables. Never commit `.env.local` or any file containing real secrets.
#
# Variables prefixed with NEXT_PUBLIC_ are bundled into browser JavaScript and
# are therefore PUBLIC. Only put non-secret values in them.
#
# Nothing below is needed to start working locally: `npm run dev` creates a
# local database and stores uploads on this computer.
# -----------------------------------------------------------------------------

# --- Site ---------------------------------------------------------------------
# The public URL of the website (no trailing slash). Used for canonical URLs,
# Open Graph images and the sitemap. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (all website content) --------------------------------------------
# SECRET. Postgres connection string. Leave EMPTY for local development — a local
# database is created automatically in .data/pglite.
# On the live site: your Neon database (neon.tech → project → Connection string,
# "Pooled connection"), e.g.
#   postgres://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Admin ---------------------------------------------------------------------
# SECRET. Live site only: a one-time code you choose (any long random text),
# asked for when creating the admin account at /admin/setup — so nobody else can
# claim the admin before you. Not needed locally. Can be removed after setup.
ADMIN_SETUP_CODE=

# --- Images & audio (Cloudinary) -----------------------------------------------
# Needed on the live site for uploads from the admin (photos, flyers, MP3s).
# Locally, without these, uploads are saved in .data/uploads instead.
# Find all three at cloudinary.com → Dashboard (Product environment credentials).
CLOUDINARY_CLOUD_NAME=
# SECRET (server only — never prefix with NEXT_PUBLIC_).
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Contact form (Resend) -----------------------------------------------------
# Messages from /contact are emailed to the church through Resend
# (https://resend.com). All three are SERVER-ONLY. Until they are set, the form
# shows an honest "not set up yet" message and sends nothing.
# SECRET. Create at resend.com → API Keys (permission: "Sending access").
RESEND_API_KEY=
# Inbox that receives website messages. Several? Separate with commas.
CONTACT_TO_EMAIL=
# Sender shown on the notification, on a domain verified in Resend, e.g.
# "Website <website@yourchurch.org>". For quick tests before verifying a
# domain, Resend allows "onboarding@resend.dev" (delivers only to your own
# Resend account email).
CONTACT_FROM_EMAIL=

# --- YouTube ------------------------------------------------------------------
# SECRET (server only — never prefix with NEXT_PUBLIC_). Optional but recommended.
# With a key: recent uploads come from the YouTube Data API v3 and the Watch page
# can show "Live now" / upcoming streams from YouTube's verified broadcast data.
# Without a key: recent uploads come from the channel's public RSS feed and live
# status is simply not shown. The channel itself is set in the admin
# (Church information → YouTube channel ID), not here.
# Create at console.cloud.google.com → APIs & Services → enable "YouTube Data API
# v3" → Credentials → API key. Restrict it to the YouTube Data API v3.
YOUTUBE_API_KEY=
